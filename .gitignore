.DS_Store
.idea/
.vscode/

# Local planning
IMPLEMENTATION_CHECKLIST.md

# Environment and credentials
.env
.env.*
!.env.example
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
htmlcov/
.coverage

# JavaScript
node_modules/
dist/
coverage/
*.tsbuildinfo

# Local data, model artifacts, and benchmark output
data/
models/
evaluation/datasets/*
!evaluation/datasets/README.md
# Small, redistributable evaluation datasets are tracked by exact name.
!evaluation/datasets/quality-core-v1.json
evaluation/reports/*
!evaluation/reports/README.md
load-tests/results/*
!load-tests/results/README.md
runtimes/triton/model_repository/*/
# Keep the committed Triton config templates; generated engines and copied
# preprocessing/postprocessing models stay out of Git.
!runtimes/triton/model_repository/ensemble/
!runtimes/triton/model_repository/tensorrt_llm/
runtimes/triton/model_repository/ensemble/**
runtimes/triton/model_repository/tensorrt_llm/**
!runtimes/triton/model_repository/ensemble/config.pbtxt
!runtimes/triton/model_repository/tensorrt_llm/config.pbtxt

# Local infrastructure state
*.log
*.pid
.terraform/
terraform.tfstate*
