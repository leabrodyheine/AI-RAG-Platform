# Application
APP_ENV=development
LOG_LEVEL=INFO

# Service addresses used inside Docker Compose or Kubernetes
AGENT_SERVICE_URL=http://agent:8001
AGENT_REQUEST_TIMEOUT_SECONDS=10
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RETRIEVAL_SERVICE_URL=http://retrieval:8002
RETRIEVAL_REQUEST_TIMEOUT_SECONDS=5
INFERENCE_SERVICE_URL=http://inference:8003
INFERENCE_REQUEST_TIMEOUT_SECONDS=15

# Retrieval storage
POSTGRES_DB=rag_platform
POSTGRES_USER=rag_platform
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+asyncpg://rag_platform:local-development-only@postgres:5432/rag_platform
REDIS_URL=redis://redis:6379/0
RETRIEVAL_CACHE_TTL_SECONDS=60
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_VERSION=fastembed:BAAI/bge-small-en-v1.5:v1
EMBEDDING_CACHE_DIR=/home/appuser/.cache/fastembed
ORT_DISABLE_TELEMETRY=1

# Model serving
# deterministic is the CPU-only backend for local development and tests.
# vllm and triton call a GPU model server; see runtimes/ for how to start one.
INFERENCE_BACKEND=deterministic
# For vllm/triton, set this to the served model name (vllm) or model
# repository name such as "ensemble" (triton).
INFERENCE_MODEL=deterministic-grounded-v1
INFERENCE_BACKEND_TIMEOUT_SECONDS=30
# Required only when INFERENCE_BACKEND is vllm or triton. From Compose the host
# server is reachable at http://host.docker.internal:8000.
VLLM_BASE_URL=http://host.docker.internal:8000
TRITON_BASE_URL=http://host.docker.internal:8000
# Comma-separated stop strings applied to every generation, for reproducibility.
INFERENCE_STOP_SEQUENCES=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
